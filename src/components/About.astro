---
import { portfolioData } from "../data/portfolioData";
const { resume_professionnel, soft_skills, centres_interet, langues } = portfolioData;
---

<section id="about" class="py-20 bg-slate-50 dark:bg-slate-900">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-4" data-aos="fade-up">
        À propos de <span class="text-primary-600 dark:text-primary-400">moi</span>
      </h2>
      <div class="w-24 h-1 bg-secondary-500 mx-auto rounded-full"></div>
    </div>

    <!-- Intro : image + texte côte à côte -->
    <div class="flex flex-col lg:flex-row items-center gap-10 mb-16">
      <div class="lg:w-2/5 w-full" data-aos="fade-right" data-aos-delay="200">
        <div class="relative overflow-hidden rounded-xl shadow-xl">
          <img
            src="https://images.pexels.com/photos/3861969/pexels-photo-3861969.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1"
            alt="Photo professionnelle"
            class="w-full h-72 sm:h-80 object-cover transition-transform duration-700 hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 to-transparent flex items-end">
            <p class="p-6 text-white text-lg font-semibold italic">
              "L'intelligence artificielle est l'avenir, et je veux en faire partie."
            </p>
          </div>
        </div>
      </div>

      <div class="lg:w-3/5 w-full" data-aos="fade-left" data-aos-delay="300">
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">
          Qui suis-je ?
        </h3>
        <p class="text-slate-700 dark:text-slate-300 text-lg leading-relaxed mb-4">
          {resume_professionnel.description}
        </p>
        <p class="text-slate-700 dark:text-slate-300 text-lg leading-relaxed">
          {resume_professionnel.objectif}
        </p>
      </div>
    </div>

    <!-- 3 cartes en grille horizontale -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Soft Skills -->
      <div class="bg-white dark:bg-slate-800 rounded-xl p-6 shadow-md hover:shadow-lg transition-shadow duration-300" data-aos="fade-up" data-aos-delay="200">
        <h4 class="text-lg font-semibold text-primary-600 dark:text-primary-400 mb-4 flex items-center">
          <i class="fas fa-brain mr-2"></i> Soft Skills
        </h4>
        <ul class="space-y-2">
          {soft_skills.map((skill) => (
            <li class="flex items-center text-slate-700 dark:text-slate-300 text-sm">
              <i class="fas fa-check-circle text-secondary-500 mr-2 text-xs"></i> {skill}
            </li>
          ))}
        </ul>
      </div>

      <!-- Centres d'intérêt -->
      <div class="bg-white dark:bg-slate-800 rounded-xl p-6 shadow-md hover:shadow-lg transition-shadow duration-300" data-aos="fade-up" data-aos-delay="300">
        <h4 class="text-lg font-semibold text-primary-600 dark:text-primary-400 mb-4 flex items-center">
          <i class="fas fa-heart mr-2"></i> Centres d'intérêt
        </h4>
        <ul class="space-y-2">
          {centres_interet.map((interet) => (
            <li class="flex items-center text-slate-700 dark:text-slate-300 text-sm">
              <i class="fas fa-star text-accent-500 mr-2 text-xs"></i> {interet}
            </li>
          ))}
        </ul>
      </div>

      <!-- Langues -->
      <div class="bg-white dark:bg-slate-800 rounded-xl p-6 shadow-md hover:shadow-lg transition-shadow duration-300" data-aos="fade-up" data-aos-delay="400">
        <h4 class="text-lg font-semibold text-primary-600 dark:text-primary-400 mb-4 flex items-center">
          <i class="fas fa-language mr-2"></i> Langues
        </h4>
        <div class="space-y-4">
          {langues.map((langue) => (
            <div>
              <div class="flex justify-between mb-1">
                <span class="text-slate-700 dark:text-slate-300 text-sm">{langue.langue}</span>
                <span class="text-slate-500 dark:text-slate-400 text-xs">{langue.niveau}</span>
              </div>
              <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2">
                <div class="bg-primary-600 dark:bg-primary-500 h-2 rounded-full" style={`width: ${
                  langue.niveau.includes("maternelle") ? "100%" :
                  langue.niveau.includes("Courant") ? "80%" :
                  langue.niveau.includes("Débutant") ? "40%" : "60%"
                }`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
