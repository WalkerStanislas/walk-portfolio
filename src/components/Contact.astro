---
import { portfolioData } from "../data/portfolioData";
const { informations_personnelles, liens_professionnels } = portfolioData;
---

<section id="contact" class="py-20 bg-white dark:bg-slate-800">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-4" data-aos="fade-up">
        Me <span class="text-primary-600 dark:text-primary-400">contacter</span>
      </h2>
      <div class="w-24 h-1 bg-secondary-500 mx-auto rounded-full"></div>
      <p class="mt-4 text-slate-700 dark:text-slate-300 max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="200">
        Vous avez un projet en tête ou vous souhaitez simplement me contacter ? N'hésitez pas !
      </p>
    </div>

    <!-- Contact info cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-3xl mx-auto mb-14" data-aos="fade-up" data-aos-delay="300">
      <a href={`mailto:${informations_personnelles.email}`} class="group flex flex-col items-center text-center bg-slate-50 dark:bg-slate-900 rounded-xl p-6 shadow-md hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
        <div class="w-14 h-14 flex items-center justify-center rounded-full bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-400 mb-4 group-hover:scale-110 transition-transform duration-300">
          <i class="fas fa-envelope text-xl"></i>
        </div>
        <h4 class="text-sm font-semibold text-slate-900 dark:text-white mb-1">Email</h4>
        <p class="text-slate-500 dark:text-slate-400 text-sm break-all">{informations_personnelles.email}</p>
      </a>

      <a href={`tel:${informations_personnelles.telephone.replace(/\s+/g, '')}`} class="group flex flex-col items-center text-center bg-slate-50 dark:bg-slate-900 rounded-xl p-6 shadow-md hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
        <div class="w-14 h-14 flex items-center justify-center rounded-full bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-400 mb-4 group-hover:scale-110 transition-transform duration-300">
          <i class="fas fa-phone-alt text-xl"></i>
        </div>
        <h4 class="text-sm font-semibold text-slate-900 dark:text-white mb-1">Téléphone</h4>
        <p class="text-slate-500 dark:text-slate-400 text-sm">{informations_personnelles.telephone}</p>
      </a>

      <div class="group flex flex-col items-center text-center bg-slate-50 dark:bg-slate-900 rounded-xl p-6 shadow-md">
        <div class="w-14 h-14 flex items-center justify-center rounded-full bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-400 mb-4">
          <i class="fas fa-map-marker-alt text-xl"></i>
        </div>
        <h4 class="text-sm font-semibold text-slate-900 dark:text-white mb-1">Localisation</h4>
        <p class="text-slate-500 dark:text-slate-400 text-sm">{informations_personnelles.adresse}</p>
      </div>
    </div>

    <!-- Social links -->
    <div class="flex justify-center gap-5 mb-14" data-aos="fade-up" data-aos-delay="350">
      {liens_professionnels.github && (
        <a href={liens_professionnels.github} target="_blank" rel="noopener" class="w-11 h-11 flex items-center justify-center rounded-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-primary-600 hover:text-white dark:hover:bg-primary-500 transition-all duration-300">
          <i class="fab fa-github text-lg"></i>
        </a>
      )}
      {liens_professionnels.linkedin && (
        <a href={liens_professionnels.linkedin} target="_blank" rel="noopener" class="w-11 h-11 flex items-center justify-center rounded-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-primary-600 hover:text-white dark:hover:bg-primary-500 transition-all duration-300">
          <i class="fab fa-linkedin-in text-lg"></i>
        </a>
      )}
    </div>

    <!-- Form -->
    <div class="max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="400">
      <form id="contact-form" action="https://formspree.io/f/xnnblney" method="POST" class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-lg p-8 space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mb-2">Nom</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="Votre nom"
              class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 transition-all duration-300"
              required
            />
          </div>
          <div>
            <label for="email" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mb-2">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="Votre email"
              class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 transition-all duration-300"
              required
            />
          </div>
        </div>

        <div>
          <label for="subject" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mb-2">Sujet</label>
          <input
            type="text"
            id="subject"
            name="subject"
            placeholder="Sujet de votre message"
            class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 transition-all duration-300"
            required
          />
        </div>

        <div>
          <label for="message" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mb-2">Message</label>
          <textarea
            id="message"
            name="message"
            placeholder="Votre message"
            rows="5"
            class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 transition-all duration-300"
            required
          ></textarea>
        </div>

        <div>
          <button
            type="submit"
            class="w-full px-6 py-3 rounded-lg bg-primary-600 text-white hover:bg-primary-700 dark:bg-primary-500 dark:hover:bg-primary-600 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-primary-400 focus:ring-opacity-50"
          >
            <span>Envoyer le message</span>
            <i class="fas fa-paper-plane ml-2"></i>
          </button>
        </div>
      </form>

      <div id="success-message" class="hidden mt-6 p-4 bg-green-100 text-green-700 rounded-lg text-center">
        <p>Votre message a été envoyé avec succès ! Je vous répondrai dans les plus brefs délais.</p>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const formInputs = document.querySelectorAll('#contact-form input, #contact-form textarea');

    formInputs.forEach(input => {
      input.addEventListener('focus', () => {
        input.classList.add('ring-primary-500', 'ring-2');
        input.classList.remove('border-slate-300', 'dark:border-slate-700');
      });

      input.addEventListener('blur', () => {
        input.classList.remove('ring-primary-500', 'ring-2');
        input.classList.add('border-slate-300', 'dark:border-slate-700');
      });
    });
  });
</script>
