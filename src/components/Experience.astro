---
import { portfolioData } from "../data/portfolioData";
const { formation, experiences_professionnelles } = portfolioData;
---

<section id="experience" class="py-20 bg-slate-50 dark:bg-slate-900">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-4" data-aos="fade-up">
        Expérience <span class="text-primary-600 dark:text-primary-400">& Formation</span>
      </h2>
      <div class="w-24 h-1 bg-secondary-500 mx-auto rounded-full"></div>
    </div>

    <div class="space-y-16">
      <!-- Formation -->
      <div data-aos="fade-up" data-aos-delay="200">
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-8 flex items-center">
          <i class="fas fa-graduation-cap text-primary-600 dark:text-primary-400 mr-3"></i>
          Formation
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {formation.map((item, index) => (
            <div class="bg-white dark:bg-slate-800 rounded-lg p-6 shadow-md hover:shadow-lg transition-all duration-300 border-l-4 border-primary-500" data-aos="fade-up" data-aos-delay={300 + index * 100}>
              <h4 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">{item.diplome}</h4>
              <p class="text-slate-700 dark:text-slate-300 mb-2">{item.etablissement}</p>
              <p class="text-primary-600 dark:text-primary-400 text-sm font-medium flex items-center">
                <i class="far fa-calendar-alt mr-2"></i> {item.periode}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- Expérience Professionnelle -->
      <div data-aos="fade-up" data-aos-delay="200">
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-8 flex items-center">
          <i class="fas fa-briefcase text-secondary-500 dark:text-secondary-400 mr-3"></i>
          Expérience Professionnelle
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {experiences_professionnelles.map((item, index) => (
            <div class="bg-white dark:bg-slate-800 rounded-lg p-5 shadow-md hover:shadow-lg transition-all duration-300 border-l-4 border-secondary-500" data-aos="fade-up" data-aos-delay={300 + index * 80}>
              <div class="flex items-baseline justify-between gap-2 mb-2">
                <h4 class="text-lg font-semibold text-slate-900 dark:text-white leading-tight">{item.poste}</h4>
              </div>
              <p class="text-secondary-600 dark:text-secondary-400 font-medium text-sm mb-2">{item.entreprise}</p>
              <p class="text-slate-600 dark:text-slate-300 text-sm mb-3">{item.description}</p>
              <p class="text-secondary-600 dark:text-secondary-400 text-xs font-medium flex items-center">
                <i class="far fa-calendar-alt mr-1.5"></i>{item.periode}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
